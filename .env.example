# Secret que Spoter debe enviar en el header X-Webhook-Secret.
# Si está vacío o ausente, /v1/spoter/webhook responde 500 (fail-closed).
WEBHOOK_SECRET=

# Credenciales para el login dinámico contra {host}/api/auth.json.
SPOTER_API_USER=
SPOTER_API_PASS=

# Ruta del cache de tokens en disco. Si está vacío, el cache vive solo en RAM.
# En Docker se monta ./data volume; el default del compose apunta a /app/data/auth.json.
TOKEN_CACHE_PATH=./data/auth.json

# OpenRouter — transcripción de audio.
OPENROUTER_API_KEY=
TRANSCRIPTION_MODEL=openai/whisper-large-v3-turbo

# Identidad de la action agregar_nota.
# Spoter requiere un id_user real; ponelo al operador de servicio que corresponde.
MISS_SERVICE_USER_ID=
# Prefijo que va antes del texto transcripto en la nota que se le manda al CRM.
MISS_NOTE_PREFIX=[Transcripción de audio]

# Dashboard: persistencia + basic auth para /api/runs, /api/runs/{id}, /api/metrics.
# Sin las creds seteadas, esos endpoints responden 500 (fail-closed).
RUNS_DB_PATH=./data/runs.db
MISS_DASHBOARD_USER=
MISS_DASHBOARD_PASS=
# CORS opcional — lista de orígenes separados por coma. Vacío = no CORS.
MISS_CORS_ORIGINS=
